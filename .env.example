# Optional settings for HackFlow. Copy to `.env` (which git ignores) only if
# you want them - with no .env at all, `docker compose up` works as-is, email
# stays off, and HackFlow makes zero outbound network calls.
#
# After changing anything here: docker compose up -d api

# --- Password-reset email (PLAN.md Phase 9.3) ------------------------------
# Leave SMTP_HOST empty to keep email off. People who forget their password
# then get a reset link from an organizer instead.

# Gmail / Google Workspace. Needs 2-step verification on the account and an
# *app password* (Google account > Security > App passwords) - your normal
# password will be rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=events@your-domain.example
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=HackFlow <events@your-domain.example>

# Outlook / Microsoft 365 instead:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls

# Port 465 servers use SMTP_SECURITY=ssl. `none` is only for a local test
# inbox - see docker-compose.mail.yml, which sets everything up for you.

# The address people reach HackFlow at. Reset emails link here, so set it to
# your real URL once HackFlow is on a server. Defaults to http://localhost:8000.
# APP_BASE_URL=https://hackflow.your-domain.example

# --- Security and integrations (docs/SECURITY-AUDIT.md) ---------------------
# Behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel), say how many sit in
# front of HackFlow so rate limits see each visitor's own address. 0 = none.
# TRUSTED_PROXY_HOPS=1

# Webhooks refuse private/loopback addresses (SSRF protection). Set to 1 only
# for a local demo whose receiver runs on this machine or LAN, such as Raptor
# Relay (https://github.com/sarvan-2187/hackflow-third-party).
# WEBHOOK_ALLOW_PRIVATE=1

# Session cookies are https-only automatically when APP_BASE_URL is https.
# COOKIE_SECURE=1

# Global per-address limits (requests a minute). 0 disables one.
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_WRITES_PER_MINUTE=120
# RATE_LIMIT_API_KEY_PER_MINUTE=1200
